{
    "compileOnSave": false,
    "compilerOptions": {
        "esModuleInterop": true,
        "rootDir": ".",
        "sourceMap": true,
        "declaration": false,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "importHelpers": true,
        "target": "esnext",
        "module": "commonjs",
        "lib": ["es2020", "dom"],
        "skipLibCheck": true,
        "skipDefaultLibCheck": true,
        "strict": false,
        "strictNullChecks": true,
        "types": ["node"]
    },
    "exclude": ["node_modules", "tmp"]
}

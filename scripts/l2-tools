      action="stop"
      shift
      l2_tools_data_stop_parse_requirements "$@"
      shift $#
      ;;

    "")
      l2_tools_data_usage >&2
      exit 1
      ;;

    *)
      printf "invalid command: %s\n" "$action" >&2
      exit 1
      ;;

  esac

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --)
        shift
        while [[ $# -gt 0 ]]; do
          key="$1"

          printf "invalid argument: %s\n" "$key" >&2
          exit 1

        done
        break
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

}

l2_tools_data_start_parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        l2_tools_data_start_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action="data start"

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --)
        shift
        while [[ $# -gt 0 ]]; do
          key="$1"

          printf "invalid argument: %s\n" "$key" >&2
          exit 1

        done
        break
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

}

l2_tools_data_stop_parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        l2_tools_data_stop_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action="data stop"

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --clean | -c)

        args['--clean']=1
        shift
        ;;

      --)
        shift
        while [[ $# -gt 0 ]]; do
          key="$1"

          printf "invalid argument: %s\n" "$key" >&2
          exit 1

        done
        break
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

}

initialize() {
  declare -g version="0.1.0"
  set -e

  declare -g mark="[@@@ L2-TOOLS]"

}

run() {

  declare -g long_usage=''
  declare -g -A args=()
  declare -g -A deps=()
  declare -g -a env_var_names=()
  declare -g -a input=()

  normalize_input "$@"
  parse_requirements "${input[@]}"

  case "$action" in
    "network") l2_tools_network_command ;;
    "l1") l2_tools_l1_command ;;
    "l1 start") l2_tools_l1_start_command ;;
    "l1 stop") l2_tools_l1_stop_command ;;
    "l2") l2_tools_l2_command ;;
    "l2 start") l2_tools_l2_start_command ;;
    "l2 stop") l2_tools_l2_stop_command ;;
    "l2 init") l2_tools_l2_init_command ;;
    "l2 bundler") l2_tools_l2_bundler_command ;;
    "bc") l2_tools_bc_command ;;
    "bc start") l2_tools_bc_start_command ;;
    "bc stop") l2_tools_bc_stop_command ;;
    "bc restore") l2_tools_bc_restore_command ;;
    "cluster") l2_tools_cluster_command ;;
    "cluster start") l2_tools_cluster_start_command ;;
    "cluster stop") l2_tools_cluster_stop_command ;;
    "data") l2_tools_data_command ;;
    "data start") l2_tools_data_start_command ;;
    "data stop") l2_tools_data_stop_command ;;
  esac
}

start() {
  command_line_args=("$@")
  initialize
  run "${command_line_args[@]}"
}

start "$@"

l2_tools_cluster_parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        l2_tools_cluster_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action=${1:-}

  case $action in
    -*) ;;

    start)
      action="start"
      shift
      l2_tools_cluster_start_parse_requirements "$@"
      shift $#
      ;;

    stop)
      action="stop"
      shift
      l2_tools_cluster_stop_parse_requirements "$@"
      shift $#
      ;;

    "")
      l2_tools_cluster_usage >&2
      exit 1
      ;;

    *)
      printf "invalid command: %s\n" "$action" >&2
      exit 1
      ;;

  esac

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --)
        shift
        while [[ $# -gt 0 ]]; do
          key="$1"

          printf "invalid argument: %s\n" "$key" >&2
          exit 1

        done
        break
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

}

l2_tools_cluster_start_parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        l2_tools_cluster_start_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action="cluster start"

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --profile | -p)

        if [[ -n ${2+x} ]]; then
          args['--profile']="$2"
          shift
          shift
        else
          printf "%s\n" "--profile requires an argument: --profile, -p PROFILE" >&2
          exit 1
        fi
        ;;

      --network | -n)

        if [[ -n ${2+x} ]]; then
          args['--network']="$2"
          shift
          shift
        else
          printf "%s\n" "--network requires an argument: --network, -n NETWORK" >&2
          exit 1
        fi
        ;;

      --ip-address | -a)

        if [[ -n ${2+x} ]]; then
          args['--ip-address']="$2"
          shift
          shift
        else
          printf "%s\n" "--ip-address requires an argument: --ip-address, -a IP-ADDRESS" >&2
          exit 1
        fi
        ;;

      --cpus | -c)

        if [[ -n ${2+x} ]]; then
          args['--cpus']="$2"
          shift
          shift
        else
          printf "%s\n" "--cpus requires an argument: --cpus, -c CPUS" >&2
          exit 1
        fi
        ;;

      --memory | -m)

        if [[ -n ${2+x} ]]; then
          args['--memory']="$2"
          shift
          shift
        else
          printf "%s\n" "--memory requires an argument: --memory, -m MEMORY" >&2
          exit 1
        fi
        ;;

      --)
        shift
        while [[ $# -gt 0 ]]; do
          key="$1"

          printf "invalid argument: %s\n" "$key" >&2
          exit 1

        done
        break
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

  if [[ -z ${args['--profile']+x} ]]; then
    printf "missing required flag: --profile, -p PROFILE\n" >&2
    exit 1
  fi
  if [[ -z ${args['--network']+x} ]]; then
    printf "missing required flag: --network, -n NETWORK\n" >&2
    exit 1
  fi
  if [[ -z ${args['--ip-address']+x} ]]; then
    printf "missing required flag: --ip-address, -a IP-ADDRESS\n" >&2
    exit 1
  fi

  [[ -n ${args['--cpus']:-} ]] || args['--cpus']="4"
  [[ -n ${args['--memory']:-} ]] || args['--memory']="8g"

}

l2_tools_cluster_stop_parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        l2_tools_cluster_stop_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action="cluster stop"

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --profile | -p)

        if [[ -n ${2+x} ]]; then
          args['--profile']="$2"
          shift
          shift
        else
          printf "%s\n" "--profile requires an argument: --profile, -p PROFILE" >&2
          exit 1
        fi
        ;;

      --clean | -c)

        args['--clean']=1
        shift
        ;;

      --)
        shift
        while [[ $# -gt 0 ]]; do
          key="$1"

          printf "invalid argument: %s\n" "$key" >&2
          exit 1

        done
        break
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

  if [[ -z ${args['--profile']+x} ]]; then
    printf "missing required flag: --profile, -p PROFILE\n" >&2
    exit 1
  fi

}


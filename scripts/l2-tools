# Logging utilities
console() { echo -e "$mark $1"; }
info() { echo -e "$(blue $mark "[INFO]" $1)"; }
success() { echo -e "$(green $mark "[SUCCESS]" $1)"; }
error() { echo -e "$(red $mark "[ERROR]" $1)"; }

l2_tools_network_command() {

  network_name=${args['name']}

  if [ "$(docker network ls -q -f name=^${network_name}$)" ]; then
      info "network '$network_name' already exists"
  else
      base_address=${args['--base-address']}
      docker network create $network_name --gateway=$base_address.1 --subnet=$base_address.0/24 --ip-range=$base_address.0/25
      success "network '$network_name' created"
  fi

}

parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --version | -v)
        version_command
        exit
        ;;

      --help | -h)
        long_usage=yes
        l2_tools_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action=${1:-}

  case $action in
    -*) ;;

    network | n)
      action="network"
      shift
      l2_tools_network_parse_requirements "$@"
      shift $#
      ;;

    "")
      l2_tools_usage >&2
      exit 1
      ;;

    *)
      printf "invalid command: %s\n" "$action" >&2
      exit 1
      ;;

  esac

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --)
        shift
        while [[ $# -gt 0 ]]; do
          key="$1"

          printf "invalid argument: %s\n" "$key" >&2
          exit 1

        done
        break
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

}

l2_tools_network_parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        l2_tools_network_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action="network"

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --base-address | -a)

        if [[ -n ${2+x} ]]; then
          args['--base-address']="$2"
          shift
          shift
        else
          printf "%s\n" "--base-address requires an argument: --base-address, -a BASE-ADDRESS" >&2
          exit 1
        fi
        ;;

      --)
        shift
        while [[ $# -gt 0 ]]; do
          key="$1"

          if [[ -z ${args['name']+x} ]]; then
            args['name']=$1
            shift
          else
            printf "invalid argument: %s\n" "$key" >&2
            exit 1
          fi

        done
        break
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        if [[ -z ${args['name']+x} ]]; then
          args['name']=$1
          shift
        else
          printf "invalid argument: %s\n" "$key" >&2
          exit 1
        fi

        ;;

    esac
  done

  if [[ -z ${args['name']+x} ]]; then
    printf "missing required argument: NAME\nusage: l2-tools network NAME [OPTIONS]\n" >&2

    exit 1
  fi

  [[ -n ${args['--base-address']:-} ]] || args['--base-address']="172.25.0"

}

initialize() {
  declare -g version="0.1.0"
  set -e

  declare -g mark="[@@@ L2-TOOLS]"

}

run() {

  declare -g long_usage=''
  declare -g -A args=()
  declare -g -A deps=()
  declare -g -a env_var_names=()
  declare -g -a input=()

  normalize_input "$@"
  parse_requirements "${input[@]}"

  case "$action" in
    "network") l2_tools_network_command ;;
  esac
}

start() {
  command_line_args=("$@")
  initialize
  run "${command_line_args[@]}"
}

start "$@"

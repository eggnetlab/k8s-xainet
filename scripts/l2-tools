init_bc() {
    source_dir="$(cd -- "$(dirname -- "$0")" &>/dev/null && pwd)"
    bc_conf_dir=$source_dir/../bc-conf
    k8s_dir=$source_dir/../k8s/overlays/dev

    set -e
    set -a
    source $bc_conf_dir/.env
    set +a
}

init_cluster() {
    source_dir="$(cd -- "$(dirname -- "$0")" &>/dev/null && pwd)"
    minikube_conf_dir=$source_dir/../minikube

    set -a
    source $minikube_conf_dir/.env
    set +a
}

init_data() {
    source_dir="$(cd -- "$(dirname -- "$0")" &>/dev/null && pwd)"
    data_conf_dir=$source_dir/../data

    set -a
    source $data_conf_dir/.env
    set +a
}

# Logging utilities
console() { echo -e "$mark $1"; }
info() { echo -e "$(cyan $mark "[INFO]" $1)"; }
success() { echo -e "$(green $mark "[SUCCESS]" $1)"; }
error() { echo -e "$(red $mark "[ERROR]" $1)"; }

: ${SLEEP_LENGTH:=1}

check_serv() {
    ADDR=$1
    PORT=$2
    ALIAS=$3

    while ! nc -z $ADDR $PORT; do
        info "sleeping $ALIAS"
        sleep $SLEEP_LENGTH
    done

    success "$ALIAS on"
}

check_pod() {
    NAME=$1
    PORT=$2
    NAMESPACE=${3:-xainet}
    FQDN="${NAME}.${NAMESPACE}.svc.cluster.local"

    kubectl -n xainet run test-conn -q --image=busybox:1.36 --restart=Never -- sleep 300 >/dev/null 2>&1
    kubectl -n xainet wait --for=condition=Ready pod/test-conn --timeout=10s >/dev/null 2>&1

    while ! kubectl -n xainet exec test-conn -- nc -z "$FQDN" "$PORT" >/dev/null 2>&1; do
        info "sleeping $NAME"
        sleep "$SLEEP_LENGTH"
    done

    kubectl -n xainet delete pod test-conn --now >/dev/null 2>&1
    success "$NAME on"
}

l2_tools_network_command() {

  network_name=${args['name']}

  if [ "$(docker network ls -q -f name=^${network_name}$)" ]; then
      info "network '$network_name' already exists"
  else
      subnet=${args['--subnet']}
      docker network create $network_name \
          --opt com.docker.network.driver.mtu=1400 \
          --gateway=${subnet}.1 \
          --subnet=${subnet}.0/24 \
          --ip-range=${subnet}.0/25
      success "network '$network_name' created"
  fi

}

l2_tools_l1_start_command() {

  console "start l1"

  init_bc

  kurtosis run github.com/ethpandaops/ethereum-package@6.1.0 \
      --args-file $bc_conf_dir/network_params.yaml \
      --enclave $L1_NAME

  GETH_CONTAINER_NAME=$(docker ps --filter "label=kurtosis_service_name=el-1-geth-lighthouse" --format "{{.Names}}")
  docker network connect \
      --ip $L1_EL_ADDR \
       xai-devnet $GETH_CONTAINER_NAME

  GETH_CONTAINER_NAME=$(docker ps --filter "label=kurtosis_service_name=cl-1-lighthouse-geth" --format "{{.Names}}")
  docker network connect \
      --ip $L1_CL_ADDR \
       xai-devnet $GETH_CONTAINER_NAME
}

l2_tools_l1_stop_command() {

  console "stop l1"

  init_bc

  kurtosis enclave rm -f $L1_NAME
}

l2_tools_l2_start_command() {

  console "start l2"

  init_bc

  kubectl apply -k $k8s_dir/sequencer

  check_pod $L2_SEQ_NAME $L2_SEQ_PORT_GETH
  check_pod $L2_SEQ_NAME $L2_SEQ_PORT_NODE

  kubectl apply -k $k8s_dir/services

  check_pod $L2_REP_NAME $L2_REP_PORT_GETH
  check_pod $L2_REP_NAME $L2_REP_PORT_NODE
  check_pod $L2_GRAPH_NAME $L2_GRAPH_PORT

  kubectl apply -k $k8s_dir/explorer

}

l2_tools_l2_stop_command() {

  console "stop l2"

  init_bc

  kubectl delete \
      -k $k8s_dir \
      --ignore-not-found=true

}

l2_tools_l2_init_command() {

  console "init l2"

  init_bc

  kubectl apply -k $k8s_dir/setup
  kubectl apply -f $k8s_dir/init/init-l2.yaml
  kubectl wait --for=condition=complete job/init-l2 -n xainet --timeout=300s

  kubectl apply -f $k8s_dir/init/init-seq.yaml
  kubectl apply -f $k8s_dir/init/init-rep.yaml
  kubectl wait --for=condition=complete job/init-seq -n xainet --timeout=300s
  kubectl wait --for=condition=complete job/init-rep -n xainet --timeout=300s

}

l2_tools_l2_bundler_command() {

  init_bc

  if [[ "${args['--start']}" ]]; then
      console "start l2 bundler"
      kubectl apply -k $k8s_dir/bundler

      check_pod $L2_BUNDLER_NAME $L2_BUNDLER_PORT
  fi

  if [[ "${args['--stop']}" ]]; then
      console "stop l2 bundler"
      kubectl delete -k $k8s_dir/bundler
  fi

}

l2_tools_bc_start_command() {

  source_dir="$(cd -- "$(dirname -- "$0")" &>/dev/null && pwd)"

  $source_dir/l2-tools l1 start
  $source_dir/l2-tools l2 init
  $source_dir/l2-tools l2 start
}

l2_tools_bc_stop_command() {

  source_dir="$(cd -- "$(dirname -- "$0")" &>/dev/null && pwd)"

  $source_dir/l2-tools l2 stop
  $source_dir/l2-tools l1 stop

}

l2_tools_bc_restore_command() {

  source_dir="$(cd -- "$(dirname -- "$0")" &>/dev/null && pwd)"

  $source_dir/l2-tools bc stop
  $source_dir/l2-tools bc start

}

l2_tools_cluster_start_command() {

  init_cluster

  MINIKUBE_PROFILE="${args['--profile']}"

  if [ ! "$(docker ps -q -f name=$MINIKUBE_PROFILE)" ]; then
      memory=${args['--memory']}
      cpus=${args['--cpus']}

      info "starting $MINIKUBE_PROFILE"

      minikube start \
          --profile $MINIKUBE_PROFILE \
          --driver=docker \
          --container-runtime=cri-o \
          --kubernetes-version=$K8S_VERSION \
          --network=${args['--network']} \
          --static-ip=${args['--ip-address']} \
          --addons="ingress","ingress-dns","registry" \
          --memory $memory \
          --disk-size 50g \
          --cpus $cpus \
          --mount-string="$minikube_conf_dir/conf:/mnt/config"

      minikube -p $MINIKUBE_PROFILE ssh -- sudo ln -sf /mnt/config/registries.conf /etc/containers/registries.conf.d/zz-custom.conf
      minikube -p $MINIKUBE_PROFILE ssh -- sudo ln -sf /mnt/config/crio.conf /etc/crio/crio.conf.d/zz-custom.conf
      minikube -p $MINIKUBE_PROFILE ssh -- sudo systemctl restart crio

      minikube -p $MINIKUBE_PROFILE ssh -- sudo sysctl -w net.ipv4.conf.all.route_localnet=1
      minikube -p $MINIKUBE_PROFILE ssh -- "sudo nft 'add table ip localhost-masq; add chain ip localhost-masq postrouting { type nat hook postrouting priority srcnat; policy accept; }; add rule ip localhost-masq postrouting ip saddr 127.0.0.1 ip daddr != 127.0.0.0/8 masquerade'"

      kubectl -n kube-system wait --for=condition=Ready node --all --timeout=120s
  fi

  success "$MINIKUBE_PROFILE has started on address $(minikube -p $MINIKUBE_PROFILE ip)"

}

l2_tools_cluster_stop_command() {

  init_cluster

  MINIKUBE_PROFILE="${args['--profile']}"

  minikube -p $MINIKUBE_PROFILE ssh -- sudo nft delete table ip localhost-masq
  minikube -p $MINIKUBE_PROFILE stop

  if [[ "${args['--clean']}" ]]; then
    minikube -p $MINIKUBE_PROFILE delete
  fi

}

l2_tools_data_start_command() {

  console "start data"

  init_data

  docker compose -f $data_conf_dir/docker-compose.yaml up -d
  check_serv $PSQL_ADDRESS $PSQLDB_PORT $PSQL_ALIAS
  check_serv $REDIS_ADDRESS $REDIS_PORT $REDIS_ALIAS
  check_serv $IPFS_ADDRESS $IPFS_PORT $IPFS_ALIAS

}

l2_tools_data_stop_command() {

  console "exec stop data"

  init_data

  ARGS=""
  if [[ "${args['--clean']}" ]]; then
    ARGS="-v"
  fi

  docker compose -f $data_conf_dir/docker-compose.yaml down $ARGS

}

parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --version | -v)
        version_command
        exit
        ;;

      --help | -h)
        long_usage=yes
        l2_tools_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action=${1:-}

  case $action in
    -*) ;;

    network | n)
      action="network"
      shift
      l2_tools_network_parse_requirements "$@"
      shift $#
      ;;

    l1)
      action="l1"
      shift
      l2_tools_l1_parse_requirements "$@"
      shift $#
      ;;

    l2)
      action="l2"
      shift
      l2_tools_l2_parse_requirements "$@"
      shift $#
      ;;

    bc)
      action="bc"
      shift
      l2_tools_bc_parse_requirements "$@"
      shift $#
      ;;

    cluster)
      action="cluster"
      shift
      l2_tools_cluster_parse_requirements "$@"
      shift $#
      ;;

    data)
      action="data"
      shift
      l2_tools_data_parse_requirements "$@"
      shift $#
      ;;

    "")
      l2_tools_usage >&2
      exit 1
      ;;

    *)
      printf "invalid command: %s\n" "$action" >&2
      exit 1
      ;;

  esac

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --)
        shift
        while [[ $# -gt 0 ]]; do
          key="$1"

          printf "invalid argument: %s\n" "$key" >&2
          exit 1

        done
        break
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

}

l2_tools_network_parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        l2_tools_network_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action="network"

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --subnet | -s)

        if [[ -n ${2+x} ]]; then
          args['--subnet']="$2"
          shift
          shift
        else
          printf "%s\n" "--subnet requires an argument: --subnet, -s SUBNET" >&2
          exit 1
        fi
        ;;

      --)
        shift
        while [[ $# -gt 0 ]]; do
          key="$1"

          if [[ -z ${args['name']+x} ]]; then
            args['name']=$1
            shift
          else
            printf "invalid argument: %s\n" "$key" >&2
            exit 1
          fi

        done
        break
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        if [[ -z ${args['name']+x} ]]; then
          args['name']=$1
          shift
        else
          printf "invalid argument: %s\n" "$key" >&2
          exit 1
        fi

        ;;

    esac
  done

  if [[ -z ${args['name']+x} ]]; then
    printf "missing required argument: NAME\nusage: l2-tools network NAME [OPTIONS]\n" >&2

    exit 1
  fi

  if [[ -z ${args['--subnet']+x} ]]; then
    printf "missing required flag: --subnet, -s SUBNET\n" >&2
    exit 1
  fi

}


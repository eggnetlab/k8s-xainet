initialize() {
  declare -g version="0.1.0"
  set -e

  declare -g mark="[@@@ L2-TOOLS]"

}

run() {

  declare -g long_usage=''
  declare -g -A args=()
  declare -g -A deps=()
  declare -g -a env_var_names=()
  declare -g -a input=()

  normalize_input "$@"
  parse_requirements "${input[@]}"

  case "$action" in
    "network") l2_tools_network_command ;;
    "l1") l2_tools_l1_command ;;
    "l1 start") l2_tools_l1_start_command ;;
    "l1 stop") l2_tools_l1_stop_command ;;
    "bc") l2_tools_bc_command ;;
    "bc start") l2_tools_bc_start_command ;;
    "bc stop") l2_tools_bc_stop_command ;;
    "bc restore") l2_tools_bc_restore_command ;;
  esac
}

start() {
  command_line_args=("$@")
  initialize
  run "${command_line_args[@]}"
}

start "$@"

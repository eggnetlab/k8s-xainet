l2_tools_l2_bundler_parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        l2_tools_l2_bundler_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action="l2 bundler"

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --start | -r)

        if [[ -n "${args['--stop']:-}" ]]; then
          printf "conflicting options: %s cannot be used with %s\n" "$key" "--stop" >&2
          exit 1
        fi

        args['--start']=1
        shift
        ;;

      --stop | -s)

        if [[ -n "${args['--start']:-}" ]]; then
          printf "conflicting options: %s cannot be used with %s\n" "$key" "--start" >&2
          exit 1
        fi

        args['--stop']=1
        shift
        ;;

      --)
        shift
        while [[ $# -gt 0 ]]; do
          key="$1"

          printf "invalid argument: %s\n" "$key" >&2
          exit 1

        done
        break
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

}


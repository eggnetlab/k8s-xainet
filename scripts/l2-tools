version_command() {
  echo "$version"
}

l2_tools_usage() {
  printf "l2-tools - Local environment management\n\n"

  printf "%s\n" "Usage:"
  printf "  l2-tools COMMAND\n"
  printf "  l2-tools [COMMAND] --help | -h\n"
  printf "  l2-tools --version | -v\n"
  echo

  printf "%s\n" "Commands:"
  printf "  %s   \n" "network"
  printf "  %s   l1 utilities\n" "l1     "
  printf "  %s   bc utilities\n" "bc     "
  echo

  if [[ -n "$long_usage" ]]; then

    printf "%s\n" "Options:"

    printf "  %s\n" "--help, -h"
    printf "    Show this help\n"
    echo
    printf "  %s\n" "--version, -v"
    printf "    Show version number\n"
    echo

  fi
}

l2_tools_network_usage() {
  printf "l2-tools network\n\n"
  printf "Alias: n\n"
  echo

  printf "%s\n" "Usage:"
  printf "  l2-tools network NAME [OPTIONS]\n"
  printf "  l2-tools network --help | -h\n"
  echo

  if [[ -n "$long_usage" ]]; then

    printf "%s\n" "Options:"

    printf "  %s\n" "--subnet, -s SUBNET (required)"
    printf "    network subnet\n"
    echo

    printf "  %s\n" "--help, -h"
    printf "    Show this help\n"
    echo

    printf "%s\n" "Arguments:"

    printf "  %s\n" "NAME"
    printf "    network name\n"
    echo

    printf "%s\n" "Examples:"
    printf "  l2-tools network xai-devnet\n"
    printf "  l2-tools network l2-devnet -s 172.26.0\n"
    echo

  fi
}


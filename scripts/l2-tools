# Logging utilities
console() { echo -e "$mark $1"; }
info() { echo -e "$(cyan $mark "[INFO]" $1)"; }
success() { echo -e "$(green $mark "[SUCCESS]" $1)"; }
error() { echo -e "$(red $mark "[ERROR]" $1)"; }

init_l1() {
    source_dir="$(cd -- "$(dirname -- "$0")" &>/dev/null && pwd)"
    l1_conf_dir=$source_dir/../l1-conf

    set -e
    set -a
    source $l1_conf_dir/.env
    set +a
}

l2_tools_network_command() {

  network_name=${args['name']}

  if [ "$(docker network ls -q -f name=^${network_name}$)" ]; then
      info "network '$network_name' already exists"
  else
      subnet=${args['--subnet']}
      docker network create $network_name --gateway=${subnet}.1 --subnet=${subnet}.0/24 --ip-range=${subnet}.0/25
      success "network '$network_name' created"
  fi

}

l2_tools_l1_start_command() {

  console "start l1"

  init_l1

  kurtosis run github.com/ethpandaops/ethereum-package@5.0.1 \
      --args-file $l1_conf_dir/network_params.yaml \
      --enclave $L1_NAME

  GETH_CONTAINER_NAME=$(docker ps --filter "label=kurtosis_service_name=el-1-geth-lighthouse" --format "{{.Names}}")
  docker network connect \
      --ip $L1_EL_ADDR \
       xai-devnet $GETH_CONTAINER_NAME

  GETH_CONTAINER_NAME=$(docker ps --filter "label=kurtosis_service_name=cl-1-lighthouse-geth" --format "{{.Names}}")
  docker network connect \
      --ip $L1_CL_ADDR \
       xai-devnet $GETH_CONTAINER_NAME
}

l2_tools_l1_stop_command() {

  console "stop l1"

  init_l1

  kurtosis enclave rm -f $L1_NAME
}

l2_tools_bc_start_command() {

  source_dir="$(cd -- "$(dirname -- "$0")" &>/dev/null && pwd)"

  $source_dir/l2-tools l1 start
  #$source_dir/l2-tools l2 init
  #$source_dir/l2-tools l2 start
}

l2_tools_bc_stop_command() {

  source_dir="$(cd -- "$(dirname -- "$0")" &>/dev/null && pwd)"

  # $source_dir/l2-tools l2 stop
  $source_dir/l2-tools l1 stop

}

l2_tools_bc_restore_command() {

  source_dir="$(cd -- "$(dirname -- "$0")" &>/dev/null && pwd)"

  $source_dir/l2-tools bc stop -o
  $source_dir/l2-tools bc start -o

}

parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --version | -v)
        version_command
        exit
        ;;

      --help | -h)
        long_usage=yes
        l2_tools_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action=${1:-}

  case $action in
    -*) ;;

    network | n)
      action="network"
      shift
      l2_tools_network_parse_requirements "$@"
      shift $#
      ;;

    l1)
      action="l1"
      shift
      l2_tools_l1_parse_requirements "$@"
      shift $#
      ;;

    bc)
      action="bc"
      shift
      l2_tools_bc_parse_requirements "$@"
      shift $#
      ;;

    "")
      l2_tools_usage >&2
      exit 1
      ;;

    *)
      printf "invalid command: %s\n" "$action" >&2
      exit 1
      ;;

  esac

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --)
        shift
        while [[ $# -gt 0 ]]; do
          key="$1"

          printf "invalid argument: %s\n" "$key" >&2
          exit 1

        done
        break
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

}

l2_tools_network_parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        l2_tools_network_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action="network"

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --subnet | -s)

        if [[ -n ${2+x} ]]; then
          args['--subnet']="$2"
          shift
          shift
        else
          printf "%s\n" "--subnet requires an argument: --subnet, -s SUBNET" >&2
          exit 1
        fi
        ;;

      --)
        shift
        while [[ $# -gt 0 ]]; do
          key="$1"

          if [[ -z ${args['name']+x} ]]; then
            args['name']=$1
            shift
          else
            printf "invalid argument: %s\n" "$key" >&2
            exit 1
          fi

        done
        break
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        if [[ -z ${args['name']+x} ]]; then
          args['name']=$1
          shift
        else
          printf "invalid argument: %s\n" "$key" >&2
          exit 1
        fi

        ;;

    esac
  done

  if [[ -z ${args['name']+x} ]]; then
    printf "missing required argument: NAME\nusage: l2-tools network NAME [OPTIONS]\n" >&2

    exit 1
  fi

  if [[ -z ${args['--subnet']+x} ]]; then
    printf "missing required flag: --subnet, -s SUBNET\n" >&2
    exit 1
  fi

}


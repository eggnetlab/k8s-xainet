xai_tools_l2_bundler_parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        xai_tools_l2_bundler_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action="l2 bundler"

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --start | -r)

        if [[ -n "${args['--stop']:-}" ]]; then
          printf "conflicting options: %s cannot be used with %s\n" "$key" "--stop" >&2
          exit 1
        fi

        args['--start']=1
        shift
        ;;

      --stop | -s)

        if [[ -n "${args['--start']:-}" ]]; then
          printf "conflicting options: %s cannot be used with %s\n" "$key" "--start" >&2
          exit 1
        fi

        args['--stop']=1
        shift
        ;;

      --)
        shift
        while [[ $# -gt 0 ]]; do
          key="$1"

          printf "invalid argument: %s\n" "$key" >&2
          exit 1

        done
        break
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

}

xai_tools_cluster_parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        xai_tools_cluster_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action=${1:-}

  case $action in
    -*) ;;

    start)
      action="start"
      shift
      xai_tools_cluster_start_parse_requirements "$@"
      shift $#
      ;;

    stop)
      action="stop"
      shift
      xai_tools_cluster_stop_parse_requirements "$@"
      shift $#
      ;;

    "")
      xai_tools_cluster_usage >&2
      exit 1
      ;;

    *)
      printf "invalid command: %s\n" "$action" >&2
      exit 1
      ;;

  esac

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --)
        shift
        while [[ $# -gt 0 ]]; do
          key="$1"

          printf "invalid argument: %s\n" "$key" >&2
          exit 1

        done
        break
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

}

xai_tools_cluster_start_parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        xai_tools_cluster_start_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action="cluster start"

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --cpus | -c)

        if [[ -n ${2+x} ]]; then
          args['--cpus']="$2"
          shift
          shift
        else
          printf "%s\n" "--cpus requires an argument: --cpus, -c CPUS" >&2
          exit 1
        fi
        ;;

      --memory | -m)

        if [[ -n ${2+x} ]]; then
          args['--memory']="$2"
          shift
          shift
        else
          printf "%s\n" "--memory requires an argument: --memory, -m MEMORY" >&2
          exit 1
        fi
        ;;

      --)
        shift
        while [[ $# -gt 0 ]]; do
          key="$1"

          printf "invalid argument: %s\n" "$key" >&2
          exit 1

        done
        break
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

  [[ -n ${args['--cpus']:-} ]] || args['--cpus']="4"
  [[ -n ${args['--memory']:-} ]] || args['--memory']="8g"

}

xai_tools_cluster_stop_parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        xai_tools_cluster_stop_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action="cluster stop"

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --clean | -c)

        args['--clean']=1
        shift
        ;;

      --)
        shift
        while [[ $# -gt 0 ]]; do
          key="$1"

          printf "invalid argument: %s\n" "$key" >&2
          exit 1

        done
        break
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

}


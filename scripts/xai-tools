init_bc() {
    source_dir="$(cd -- "$(dirname -- "$0")" &>/dev/null && pwd)"
    bc_conf_dir=$source_dir/../bc-conf
    k8s_dir=$source_dir/../k8s/overlays/dev

    set -e
    set -a
    source $bc_conf_dir/.env
    set +a
}

init_cluster() {
    source_dir="$(cd -- "$(dirname -- "$0")" &>/dev/null && pwd)"
    minikube_conf_dir=$source_dir/../minikube

    set -a
    source $minikube_conf_dir/.env
    set +a
}

init_data() {
    source_dir="$(cd -- "$(dirname -- "$0")" &>/dev/null && pwd)"
    data_conf_dir=$source_dir/../data

    set -a
    source $data_conf_dir/.env
    set +a
}

# Logging utilities
console() { echo -e "$mark $1"; }
info() { echo -e "$(cyan $mark "[INFO]" $1)"; }
success() { echo -e "$(green $mark "[SUCCESS]" $1)"; }
error() { echo -e "$(red $mark "[ERROR]" $1)"; }

: ${SLEEP_LENGTH:=1}
: ${MAX_TRIES:=120}

check_serv() {
    ADDR=$1
    PORT=$2
    ALIAS=$3

    tries=0
    while ! nc -z $ADDR $PORT; do
        tries=$((tries + 1))
        if (( tries >= MAX_TRIES )); then
            error "$ALIAS ($ADDR:$PORT) not reachable after $MAX_TRIES tries"
            return 1
        fi
        info "sleeping $ALIAS"
        sleep $SLEEP_LENGTH
    done

    success "$ALIAS on"
}

check_pod() {
    NAME=$1
    PORT=$2
    FQDN="${NAME}.${namespace}.svc.cluster.local"

    kubectl="kubectl --context $context -n $namespace"

    $kubectl delete pod test-conn --now --ignore-not-found >/dev/null
    $kubectl run test-conn -q --image=busybox:1.36 --restart=Never -- sleep 300 >/dev/null \
        || { error "cannot create the test-conn pod"; return 1; }
    $kubectl wait --for=condition=Ready pod/test-conn --timeout=120s >/dev/null \
        || { error "test-conn is not ready"; $kubectl describe pod test-conn | tail -n 15; return 1; }

    tries=0
    until $kubectl exec test-conn -- nc -z "$FQDN" "$PORT" >/dev/null 2>&1; do
        tries=$((tries + 1))
        if (( tries >= MAX_TRIES )); then
            error "$NAME:$PORT not reachable after $MAX_TRIES tries"
            $kubectl delete pod test-conn --now >/dev/null
            return 1
        fi
        info "sleeping $NAME"
        sleep "$SLEEP_LENGTH"
    done

    $kubectl delete pod test-conn --now >/dev/null

    success "$NAME on"
}

is_cluster_running() {
    [[ -n "$(docker ps -q -f name=$context)" ]];
}

xai_tools_network_command() {

  if [ "$(docker network ls -q -f name=^${network_name}$)" ]; then
      info "network '$network_name' already exists"
  else
      docker network create "$network_name" \
          --opt com.docker.network.driver.mtu=1400 \
          --gateway=${network_subnet}.1 \
          --subnet=${network_subnet}.0/24 \
          --ip-range=${network_subnet}.0/25 \
          --opt com.docker.network.bridge.name="br_${network_name}"
      success "network '$network_name' created"
  fi

}

xai_tools_l1_start_command() {

  console "start l1"

  init_bc

  kurtosis run github.com/ethpandaops/ethereum-package@6.1.0 \
      --args-file $bc_conf_dir/network_params.yaml \
      --enclave $L1_NAME

  GETH_CONTAINER_NAME=$(docker ps --filter "label=kurtosis_service_name=el-1-geth-lighthouse" --format "{{.Names}}")
  docker network connect \
      --ip $L1_EL_ADDR \
       xai-devnet $GETH_CONTAINER_NAME

  GETH_CONTAINER_NAME=$(docker ps --filter "label=kurtosis_service_name=cl-1-lighthouse-geth" --format "{{.Names}}")
  docker network connect \
      --ip $L1_CL_ADDR \
       xai-devnet $GETH_CONTAINER_NAME
}

xai_tools_l1_stop_command() {

  console "stop l1"

  init_bc

  if [[ -n "$(kurtosis enclave ls --cli-log-level warning | grep $L1_NAME)" ]]; then
      kurtosis enclave rm -f $L1_NAME
  fi
}

xai_tools_l2_start_command() {

  console "start l2"

  init_bc

  kubectl --context $context apply -k $k8s_dir/sequencer

  check_pod $L2_SEQ_NAME $L2_SEQ_PORT_GETH
  check_pod $L2_SEQ_NAME $L2_SEQ_PORT_NODE

  kubectl --context $context apply -k $k8s_dir/services

  check_pod $L2_REP_NAME $L2_REP_PORT_GETH
  check_pod $L2_REP_NAME $L2_REP_PORT_NODE
  check_pod $L2_GRAPH_NAME $L2_GRAPH_PORT

  kubectl --context $context apply -k $k8s_dir/explorer

}

xai_tools_l2_stop_command() {

  console "stop l2"

  init_bc

  if is_cluster_running; then
      kubectl --context $context \
          delete \
          -k $k8s_dir \
          --ignore-not-found=true
  fi
}

xai_tools_l2_init_command() {

  console "init l2"

  init_bc

  kubectl="kubectl --context $context -n $namespace"

  $kubectl apply -k $k8s_dir/setup
  $kubectl apply -f $k8s_dir/init/init-l2.yaml
  $kubectl wait --for=condition=complete job/init-l2 --timeout=300s

  $kubectl apply -f $k8s_dir/init/init-seq.yaml
  $kubectl apply -f $k8s_dir/init/init-rep.yaml
  $kubectl wait --for=condition=complete job/init-seq --timeout=300s
  $kubectl wait --for=condition=complete job/init-rep --timeout=300s

}

xai_tools_l2_bundler_command() {

  init_bc

  if [[ "${args['--start']:-}" ]]; then
      console "start l2 bundler"
      kubectl --context $context apply -k $k8s_dir/bundler

      check_pod $L2_BUNDLER_NAME $L2_BUNDLER_PORT
  fi

  if [[ "${args['--stop']:-}" ]]; then
      console "stop l2 bundler"
      kubectl --context $context delete -k $k8s_dir/bundler
  fi

}

xai_tools_cluster_start_command() {

  init_cluster

  if ! is_cluster_running; then
      memory=${args['--memory']}
      cpus=${args['--cpus']}

      info "starting $context"

      minikube start \
          --profile $context \
          --driver=docker \
          --container-runtime=cri-o \
          --kubernetes-version=$K8S_VERSION \
          --network=${network_name} \
          --static-ip=${network_subnet}.247 \
          --addons="ingress,ingress-dns,registry" \
          --memory $memory \
          --disk-size 50g \
          --cpus $cpus \
          --mount-string="$minikube_conf_dir/conf:/mnt/config"

      minikube -p $context ssh -- sudo ln -sf /mnt/config/registries.conf /etc/containers/registries.conf.d/zz-custom.conf
      minikube -p $context ssh -- sudo ln -sf /mnt/config/crio.conf /etc/crio/crio.conf.d/zz-custom.conf
      minikube -p $context ssh -- sudo systemctl restart crio

      minikube -p $context ssh -- sudo sysctl -w net.ipv4.conf.all.route_localnet=1
      minikube -p $context ssh -- "sudo nft 'add table ip localhost-masq; add chain ip localhost-masq postrouting { type nat hook postrouting priority srcnat; policy accept; }; add rule ip localhost-masq postrouting ip saddr 127.0.0.1 ip daddr != 127.0.0.0/8 masquerade'"

      kubectl --context $context -n kube-system wait --for=condition=Ready node --all --timeout=120s

      kubectl --context $context apply -f https://github.com/kubernetes-sigs/metrics-server/releases/download/v0.9.0/components.yaml
      kubectl --context $context -n kube-system patch deployment metrics-server --type=json \
        -p='[{"op":"add","path":"/spec/template/spec/containers/0/args/-","value":"--kubelet-insecure-tls"}]'
  fi

  success "$context has started on address $(minikube -p $context ip)"

}

xai_tools_cluster_stop_command() {

  init_cluster

  if is_cluster_running; then
      minikube -p $context ssh -- sudo nft delete table ip localhost-masq
      minikube -p $context stop
  fi

  if [[ "${args['--clean']:-}" ]]; then
    minikube -p $context delete
  fi

}

xai_tools_data_start_command() {

  console "start data"

  init_data

  docker compose -f $data_conf_dir/docker-compose.yaml up -d
  check_serv $PSQL_ADDRESS $PSQLDB_PORT $PSQL_ALIAS
  check_serv $REDIS_ADDRESS $REDIS_PORT $REDIS_ALIAS
  check_serv $IPFS_ADDRESS $IPFS_PORT $IPFS_ALIAS

}

xai_tools_data_stop_command() {

  console "exec stop data"

  init_data

  ARGS=""
  if [[ "${args['--clean']:-}" ]]; then
    ARGS="-v"
  fi

  docker compose -f $data_conf_dir/docker-compose.yaml down $ARGS

}

parse_requirements() {
  local key

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --version | -v)
        version_command
        exit
        ;;

      --help | -h)
        long_usage=yes
        xai_tools_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  action=${1:-}

  case $action in
    -*) ;;

    network | n)
      action="network"
      shift
      xai_tools_network_parse_requirements "$@"
      shift $#
      ;;

    l1)
      action="l1"
      shift
      xai_tools_l1_parse_requirements "$@"
      shift $#
      ;;

    l2)
      action="l2"
      shift
      xai_tools_l2_parse_requirements "$@"
      shift $#
      ;;

    cluster)
      action="cluster"
      shift
      xai_tools_cluster_parse_requirements "$@"
      shift $#
      ;;

    data)
      action="data"
      shift
      xai_tools_data_parse_requirements "$@"
      shift $#
      ;;

    "")
      xai_tools_usage >&2
      exit 1
      ;;

    *)
      printf "invalid command: %s\n" "$action" >&2
      exit 1
      ;;

  esac

  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      --)
        shift
        while [[ $# -gt 0 ]]; do
          key="$1"

          printf "invalid argument: %s\n" "$key" >&2
          exit 1

        done
        break
        ;;

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)

        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

}


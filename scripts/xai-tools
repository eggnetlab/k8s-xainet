initialize() {
  declare -g version="0.1.0"
  set -euo pipefail

  declare -g mark="[@@@ XAI-TOOLS]"

  declare -g context="xai-kube"

  declare -g namespace="xainet"

  declare -g network_name="xai-devnet"

  declare -g network_subnet="172.25.0"

}

run() {

  declare -g long_usage=''
  declare -g -A args=()
  declare -g -a input=()

  normalize_input "$@"
  parse_requirements "${input[@]}"

  case "$action" in
    "network") xai_tools_network_command ;;
    "l1") xai_tools_l1_command ;;
    "l1 start") xai_tools_l1_start_command ;;
    "l1 stop") xai_tools_l1_stop_command ;;
    "l2") xai_tools_l2_command ;;
    "l2 start") xai_tools_l2_start_command ;;
    "l2 stop") xai_tools_l2_stop_command ;;
    "l2 init") xai_tools_l2_init_command ;;
    "l2 bundler") xai_tools_l2_bundler_command ;;
    "cluster") xai_tools_cluster_command ;;
    "cluster start") xai_tools_cluster_start_command ;;
    "cluster stop") xai_tools_cluster_stop_command ;;
    "data") xai_tools_data_command ;;
    "data start") xai_tools_data_start_command ;;
    "data stop") xai_tools_data_stop_command ;;
  esac
}

start() {
  command_line_args=("$@")
  initialize
  run "${command_line_args[@]}"
}

start "$@"
